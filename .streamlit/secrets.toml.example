# Copy to .streamlit/secrets.toml (gitignored). On Streamlit Cloud: paste ALL of it into Advanced settings → Secrets.
# Local run without [access_codes] → dev mode (reviewer role, no code needed). No SHEET_ID → nothing is saved.

ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-4-5"

SHEET_ID = "1AbC...xyz"          # a NEW Google Sheet for speaking-coach, shared with the service account email

[access_codes]
minh_hs = "minh-2841"
co_lan  = { code = "lan-7392", role = "reviewer" }

[limits]
student_daily = 10
reviewer_daily = 20
global_daily = 50

# Same service account as writing-coach can be reused (copy the [gcp_service_account] block).
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
